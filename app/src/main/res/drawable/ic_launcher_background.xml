<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Linear diagonal gradient from MintPrimary to BlueSecondary -->
    <path
        android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#00C853" android:offset="0.0" />
                <item android:color="#00B0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle circuit lines inside background to add visual depth -->
    <path
        android:pathData="M 18,18 h 72 v 72 h -72 z"
        android:strokeColor="#1FFFFFFF"
        android:strokeWidth="1"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 36,36 h 36 v 36 h -36 z"
        android:strokeColor="#1FFFFFFF"
        android:strokeWidth="1"
        android:fillColor="#00000000" />
</vector>
